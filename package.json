{
  "name": "@chrisleekr/agentsync",
  "version": "0.1.7",
  "description": "A CLI to snapshot, encrypt, and sync AI agent configs — Claude, Cursor, Codex, Copilot, VS Code — across machines via a Git vault.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/chrisleekr/agentsync#readme",
  "bugs": {
    "url": "https://github.com/chrisleekr/agentsync/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisleekr/agentsync.git"
  },
  "keywords": [
    "agentsync",
    "bun",
    "cli",
    "encryption",
    "age",
    "claude",
    "cursor",
    "codex",
    "copilot",
    "vscode"
  ],
  "bin": {
    "agentsync": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:package": "bun run scripts/build-package.ts",
    "pack:dry-run": "bun run build:package && npm pack --dry-run --json --ignore-scripts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome ci .",
    "lint:fix": "bunx biome check --write .",
    "format": "bunx biome format .",
    "format:fix": "bunx biome format --write .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "bun run typecheck && bun run lint && bun run check:docs && bun run check:spec-refs && bun run test",
    "check:docs": "bun run scripts/check-docs-mirror.ts",
    "check:spec-refs": "bun run scripts/check-spec-tracker-refs.ts",
    "check:act": "act -W .github/workflows/ci.yml",
    "e2e:all": "bash docker/e2e/run-all.sh",
    "e2e:smoke": "bash -c 'trap \"docker compose -f docker/e2e/compose.yml down -v\" EXIT; docker compose -f docker/e2e/compose.yml up --build --abort-on-container-exit --exit-code-from machine'",
    "e2e:scenario": "bash -c 'docker compose -f docker/e2e/compose.yml run --rm machine /home/agent/scenarios/${SCENARIO:?SCENARIO env var required}'",
    "e2e:audit": "docker compose -f docker/e2e/compose.yml run --rm machine /home/agent/scripts/audit-vaults.sh",
    "docs:install": "pip install -r docs/requirements.txt",
    "docs:serve": "mkdocs serve",
    "docs:build": "mkdocs build --strict",
    "prepack": "bun run build:package",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@iarna/toml": "^2.2.5",
    "@opentui/core": "^0.2.10",
    "age-encryption": "^0.3.0",
    "citty": "^0.2.2",
    "picocolors": "^1.1.1",
    "simple-git": "^3.27.0",
    "tar": "^7.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^25.6.2",
    "bun-types": "1.3.13",
    "lefthook": "^2.1.4",
    "typescript": "^6.0.0"
  },
  "volta": {
    "node": "24"
  }
}

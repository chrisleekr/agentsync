{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "dark",
  "model": "claude-opus-4-7",
  "statusLine": { "type": "command", "command": "git status -s" },
  "permissions": { "allow": ["Read(./*)"], "deny": ["Bash(curl *)"] },
  "hooks": {
    "PreToolUse": [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "echo running" }] }],
    "PostToolUse": [{ "matcher": "Edit", "hooks": [{ "type": "command", "command": "biome check --write" }] }]
  }
}

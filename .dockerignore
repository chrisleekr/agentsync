# Anchored dot-dir excludes — they apply ONLY at the build-context root, not
# to the nested `.claude/.cursor/.codex/.copilot/.vscode` paths the e2e
# fixture tree uses. Without the leading slash these patterns would match
# `docker/e2e/fixtures/**/.claude` and silently drop scenario coverage.
/.claude
/.cursor
/.codex
/.copilot
/.vscode
*.log
.env
.env.*
!.env.example
.DS_Store
